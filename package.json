{
  "name": "pig-legends",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pig Legends - dark fantasy action RPG starring the pig knight ARNO. Babylon.js + React + TypeScript PWA.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "icons": "python3 scripts/make-icons.py",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host --port 4173 --strictPort"
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.0",
    "@babylonjs/loaders": "^9.37.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
